{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "f5e281f77e8263bf946b3dca17db666aab12862a",
  "separate-pull-requests": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Build and dependencies"
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "fold",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "1.0.0",
      "draft": false,
      "prerelease": false,
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "apps/client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/vtodo/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/docs/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/outbox/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/schemas/package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": ["apps/cli", "skills/fold-todos"]
    },
    "apps/cli": {
      "release-type": "node",
      "component": "fold-cli",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true,
      "tag-separator": "-"
    }
  }
}
