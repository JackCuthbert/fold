{
  "name": "fold",
  "version": "1.6.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --no-error-on-unmatched-pattern",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "knip": "knip",
    "test": "vitest run",
    "test:integration": "bun run --filter '*' test:integration",
    "test:integration:cli": "bun run --filter @jackcuthbert/fold-cli test:integration",
    "test:e2e": "bun run --filter @fold/e2e test",
    "e2e:install": "bun run --filter @fold/e2e install:browsers",
    "screenshot": "bun run --filter @fold/e2e screenshot",
    "favicons": "bun run --filter @fold/e2e favicons",
    "seed:history": "bun run --filter @fold/e2e seed:history",
    "seed:all": "bun run --filter @fold/e2e seed:all",
    "docs": "bun run --filter @fold/docs dev",
    "docs:build": "bun run --filter @fold/docs build",
    "docs:preview": "bun run --filter @fold/docs preview",
    "fonts:convert": "bun scripts/convert-fonts.mjs",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.2",
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "release-please": "^17.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wawoff2": "^2.0.1",
    "zod": "^4.6.5"
  }
}
