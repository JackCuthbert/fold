{
  "name": "fold",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --no-error-on-unmatched-pattern",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck",
    "knip": "knip",
    "test": "vitest run",
    "test:integration": "bun run --filter @fold/server test:integration",
    "test:e2e": "bun run --filter @fold/e2e test",
    "screenshot": "bun run --filter @fold/e2e screenshot",
    "favicons": "bun run --filter @fold/e2e favicons",
    "seed:history": "bun run --filter @fold/e2e seed:history",
    "seed:all": "bun run --filter @fold/e2e seed:all",
    "docs": "bun run --filter @fold/docs dev",
    "docs:build": "bun run --filter @fold/docs build",
    "docs:preview": "bun run --filter @fold/docs preview",
    "fonts:convert": "bun scripts/convert-fonts.mjs"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.4.0",
    "knip": "^6.32.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wawoff2": "^2.0.1"
  }
}
